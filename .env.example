# ==========================================
# SafeTrace Platform Configuration
# ==========================================

# Application
PROJECT_NAME="SafeTrace"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="safetrace-insecure-secret-key-change-in-production-min-32-chars-long"

# Security & Encryption (AES-256 Fernet key for uploads at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="safetrace"
POSTGRES_PASSWORD="safetrace_secure_password"
POSTGRES_DB="safetrace_db"
DATABASE_URL="postgresql://safetrace:safetrace_secure_password@localhost:5432/safetrace_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Storage
STORAGE_DIR="storage"
UPLOAD_MAX_BYTES=26214400 # 25MB

# CORS (Frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Next.js Public Vars
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_NAME="SafeTrace"
